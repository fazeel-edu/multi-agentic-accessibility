{
  "$defs": {
    "FailureRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "kind",
        "message",
        "retryable"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "dev",
        "eval"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Role": {
      "enum": [
        "screen_reader",
        "keyboard",
        "colour_visual",
        "cognitive",
        "plain_language",
        "wcag_structure",
        "inclusive_design",
        "axe_core"
      ],
      "title": "Role",
      "type": "string"
    },
    "RoleState": {
      "enum": [
        "ok",
        "failed",
        "excluded"
      ],
      "title": "RoleState",
      "type": "string"
    },
    "RoleStatus": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "example_count": {
          "default": 0,
          "title": "Example Count",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_tokens_est": {
          "default": 0,
          "title": "Prompt Tokens Est",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "schema_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Valid"
        },
        "seconds": {
          "default": 0.0,
          "title": "Seconds",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/RoleState"
        }
      },
      "required": [
        "role",
        "state"
      ],
      "title": "RoleStatus",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "complete",
        "stopped_cost_cap",
        "failed"
      ],
      "title": "RunState",
      "type": "string"
    },
    "System": {
      "enum": [
        "axe",
        "role_multi_agent"
      ],
      "title": "System",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_hash": {
      "title": "Capture Hash",
      "type": "string"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "group_id": {
      "title": "Group Id",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "page_id": {
      "title": "Page Id",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "priority_notes": {
      "items": {
        "type": "string"
      },
      "title": "Priority Notes",
      "type": "array"
    },
    "provider_terms_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Terms Date"
    },
    "role_status": {
      "items": {
        "$ref": "#/$defs/RoleStatus"
      },
      "title": "Role Status",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seconds": {
      "default": 0.0,
      "title": "Seconds",
      "type": "number"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RunState",
      "default": "complete"
    },
    "system": {
      "$ref": "#/$defs/System"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "variant": {
      "items": {
        "$ref": "#/$defs/Role"
      },
      "title": "Variant",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "system",
    "page_id",
    "phase",
    "group_id",
    "config_hash",
    "capture_hash",
    "started_at"
  ],
  "title": "Run",
  "type": "object"
}
